{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModA3Output",
  "description": "Path A (Symptom Photo Pipeline) optional crosscheck output to Mod C",
  "type": "object",
  "required": [
    "patient_id",
    "crosscheck_signal",
    "model_confidence"
  ],
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "crosscheck_signal": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["confidence", "source", "agrees_with_path_b"],
        "properties": {
          "confidence": { "type": "number" },
          "source": { "type": "string", "enum": ["nails", "eyes", "skin", "tongue", "hair"] },
          "agrees_with_path_b": { "type": "boolean" }
        }
      }
    },
    "model_confidence": {
      "type": "number"
    }
  }
}
